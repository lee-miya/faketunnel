[Unit]
Description=fakeTunnel Edge (public ingress)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=faketunnel
Group=faketunnel
WorkingDirectory=/opt/faketunnel
ExecStart=/opt/faketunnel/bin/edge -config /opt/faketunnel/configs/edge.yaml
Restart=always
RestartSec=2
LimitNOFILE=65535
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=faketunnel-edge

[Install]
WantedBy=multi-user.target
